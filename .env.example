# =============================================================================
# CẤU HÌNH KẾT NỐI SQL SERVER
# Lần đầu chạy "npm start", file này sẽ tự được copy thành ".env".
# Bạn CHỈ CẦN SỬA DÒNG DB_SERVER trong file .env cho đúng máy mình.
# (File .env không được đưa lên Git - mỗi máy một cấu hình riêng)
# =============================================================================

# --- Kiểu đăng nhập: windows = kết nối thẳng như SSMS, KHÔNG cần tài khoản/mật khẩu (giữ nguyên) ---
DB_AUTH=windows

# --- Tên máy chủ SQL Server ---
# Copy y nguyên ô "Server name" trong cửa sổ Connect của SSMS, ví dụ:
#   localhost\SQLEXPRESS      (bản Express - phổ biến nhất)
#   DESKTOP-ABC123\SQLEXPRESS (tên máy\tên instance)
#   localhost  hoặc  .        (bản Developer / instance mặc định)
DB_SERVER=localhost\SQLEXPRESS

# --- Tên cơ sở dữ liệu (tự động tạo khi chạy npm start) ---
DB_NAME=MinhTienPharmacyGPP

# --- Tự động tạo lại CSDL khi file SQL trong dự án thay đổi (sau git pull) ---
#   true  : tự cập nhật (dữ liệu nhập tay sẽ bị thay bằng dữ liệu mẫu)
#   false : giữ nguyên CSDL, tự chạy "npm run db:init" khi muốn cập nhật
DB_AUTO_REBUILD=true

# --- Cổng chạy web ---
PORT=3000

# --- Không cần sửa (chỉ dùng khi DB_AUTH=sql) ---
DB_USER=sa
DB_PASSWORD=
DB_PORT=1433
