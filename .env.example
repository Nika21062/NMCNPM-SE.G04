# =============================================================================
# CẤU HÌNH KẾT NỐI SQL SERVER - copy file này thành ".env" rồi sửa cho máy của bạn
#   Windows:  copy .env.example .env
# File .env KHÔNG được đưa lên Git (mỗi máy một cấu hình riêng).
# =============================================================================

# --- Cổng chạy web ---
PORT=3000

# --- Máy chủ SQL Server ---
# Docker            : DB_SERVER=localhost , DB_PORT=1433 , để trống DB_INSTANCE
# SQL Server mặc định (MSSQLSERVER): giống Docker
# SQL Server Express: DB_SERVER=localhost , DB_INSTANCE=SQLEXPRESS (cần bật dịch vụ "SQL Server Browser")
DB_SERVER=localhost
DB_PORT=1433
DB_INSTANCE=

# --- Tài khoản SQL Server Authentication (KHÔNG dùng Windows Authentication) ---
DB_USER=sa
DB_PASSWORD=Sqlserver123@

# --- Tên cơ sở dữ liệu ---
DB_NAME=MinhTienPharmacyGPP

# --- Mã hóa kết nối (giữ nguyên là được) ---
DB_ENCRYPT=true
DB_TRUST_CERT=true
